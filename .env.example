# Aadrut Website Environment Variables
# Copy to .env.local for local development or configure in Vercel Project Settings.

# Admin Initial Credentials (REQUIRED: must be set explicitly, no fallback default)
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=your_strong_admin_password_min_12_chars

# Session Secret (REQUIRED in production: random 32+ char secret for HMAC signing tokens & session cookies)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_random_32_byte_session_secret_here

# Upstash Redis Distributed Store (Required for production persistence on Vercel serverless)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# App URL / Origin Allowlist
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://aadrut.tech
NEXT_PUBLIC_CONTACT_EMAIL=hello@aadrut.com
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=



