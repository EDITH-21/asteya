# Asteya Website Environment Variables
# Copy to .env.local for local development or configure in Vercel Project Settings.

# Admin Initial Credentials (used when database initializes for the first time)
ADMIN_EMAIL=admin@asteya.tech
ADMIN_INITIAL_PASSWORD=your_strong_admin_password_min_10_chars

# Cryptographic Session Secret (generate a random 32+ character hex string in production: openssl rand -hex 32)
SESSION_SECRET=your_32_character_minimum_random_secret_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

